{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {"BUILD_TESTING": true}
    },
    {
      "name": "debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/dev",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": false}
    },
    {
      "name": "sanitized",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/sanitized",
      "cacheVariables": {
        "MOORHUHN2_SANITIZERS": true
      }
    }
  ],
  "buildPresets": [
    {"name": "debug", "configurePreset": "debug", "jobs": 4},
    {"name": "release", "configurePreset": "release", "jobs": 4},
    {"name": "sanitized", "configurePreset": "sanitized", "jobs": 4}
  ],
  "testPresets": [
    {"name": "debug", "configurePreset": "debug", "output": {"outputOnFailure": true}, "execution": {"jobs": 2, "noTestsAction": "error"}},
    {"name": "sanitized", "configurePreset": "sanitized", "output": {"outputOnFailure": true}, "execution": {"jobs": 2, "noTestsAction": "error"}}
  ]
}
