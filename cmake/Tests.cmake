function(moorhuhn2_add_test)
    cmake_parse_arguments(PARSE_ARGV 0 TEST "" "TARGET;NAME;SOURCE;TIMEOUT" "LIBRARIES;LABELS;ARGS;ENVIRONMENT")
    if(TEST_UNPARSED_ARGUMENTS OR TEST_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "Invalid test registration: ${TEST_UNPARSED_ARGUMENTS} ${TEST_KEYWORDS_MISSING_VALUES}")
    endif()
    add_executable(${TEST_TARGET} ${TEST_SOURCE})
    target_include_directories(${TEST_TARGET} PRIVATE "${PROJECT_SOURCE_DIR}/tests")
    target_link_libraries(${TEST_TARGET} PRIVATE ${TEST_LIBRARIES})
    add_test(NAME ${TEST_NAME} COMMAND ${TEST_TARGET} ${TEST_ARGS})
    set_tests_properties(${TEST_NAME} PROPERTIES LABELS "${TEST_LABELS}")
    if(DEFINED TEST_TIMEOUT)
        set_tests_properties(${TEST_NAME} PROPERTIES TIMEOUT "${TEST_TIMEOUT}")
    endif()
    if(DEFINED TEST_ENVIRONMENT)
        set_tests_properties(${TEST_NAME} PROPERTIES ENVIRONMENT "${TEST_ENVIRONMENT}")
    endif()
endfunction()
